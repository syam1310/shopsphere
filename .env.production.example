# Copy to .env on the production host and replace every required placeholder.
SHOPSPHERE_DOMAIN=shop.example.com
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_SERVICE_SECRET=replace-with-a-different-long-random-secret
ADMIN_SETUP_CODE=replace-with-a-one-time-random-admin-setup-code

# Optional integrations
GOOGLE_CLIENT_ID=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=

# Monitoring (the webhook file should be chmod 600 and contain only the webhook URL)
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-long-random-password
ALERTMANAGER_SLACK_WEBHOOK_FILE=/etc/shopsphere/secrets/alertmanager-slack-webhook
